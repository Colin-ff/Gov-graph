# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# ---- PostgreSQL (consumed by docker-compose and the backend) ----
POSTGRES_USER=govgraph
POSTGRES_PASSWORD=govgraph
POSTGRES_DB=govgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Backend (Flask) ----
# Full SQLAlchemy URL. Defaults are derived from the POSTGRES_* vars above if unset.
DATABASE_URL=postgresql+psycopg2://govgraph:govgraph@localhost:5432/govgraph
FLASK_ENV=development
SECRET_KEY=dev-secret-change-me
# Comma-separated list of origins allowed to call the API (frontend dev server).
CORS_ORIGINS=http://localhost:5173
# Google Gemini API key (free tier via https://aistudio.google.com/apikey),
# used by the ToR autofill feature (POST /api/tor/autofill) and by the
# similarity-search spike's LLM verification stage (similarity_search.py).
GEMINI_API_KEY=xxx-your-api-key-here-xxx

# ---- Frontend (Vite) ----
# Base URL the React app uses to reach the backend. Must be prefixed with VITE_.
VITE_API_BASE_URL=http://localhost:5000/api
